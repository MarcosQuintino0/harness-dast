# Copie para .env e ajuste. Nunca coloque valores reais de produto aqui.
# Segredos de contas de teste são lidos por apelido (secret_ref) do ambiente,
# não por este arquivo.

# URL base da API do OWASP ZAP.
HDAST_ZAP_BASE_URL=http://127.0.0.1:8080

# Chave da API do ZAP. Deixe vazio se a chave estiver desabilitada no ZAP.
HDAST_ZAP_API_KEY=

# Proxy por onde o probe envia as requisições ao alvo, para o ZAP aprendê-las.
# Vazio = usa HDAST_ZAP_BASE_URL.
HDAST_ZAP_PROXY_URL=

# Proxy para o login e a busca do token CSRF, que não passam pelo ZAP para a senha
# não ficar no histórico dele. Vazio = conexão direta.
HDAST_AUTH_PROXY_URL=

# Arquivo com a CA do ZAP, necessário para alvos HTTPS enviados pelo proxy dele.
HDAST_ZAP_CA_FILE=

# Diretório onde cada execução grava seus arquivos (ignorado pelo git).
HDAST_RUNS_DIR=runs

# Diretório do estado da pilha gerenciada (stack.json, política e auditoria do proxy).
HDAST_STATE_DIR=

# Pasta da política do proxy de escopo, para `hdast stop` sem pilha gerenciada.
HDAST_SCOPE_POLICY_DIR=

# Diretório com os perfis de produto.
HDAST_PRODUCTS_DIR=products

# Nível mínimo de log: DEBUG, INFO, WARNING ou ERROR.
HDAST_LOG_LEVEL=INFO
