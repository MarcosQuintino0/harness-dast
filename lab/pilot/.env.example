# Copie para .env (ignorado pelo git) e troque TODOS os valores. Nada aqui e real.
# Contas de teste do alvo de treino. As senhas nunca ficam no repositorio.
PILOT_ADMIN_USERNAME=pilot_admin
PILOT_ADMIN_PASSWORD=CHANGE_ME_admin_password
PILOT_MEDICO_USERNAME=pilot_medico
PILOT_MEDICO_PASSWORD=CHANGE_ME_medico_password
PILOT_PACIENTE_A_USERNAME=pilot_paciente_a
PILOT_PACIENTE_A_PASSWORD=CHANGE_ME_paciente_a_password
PILOT_PACIENTE_B_USERNAME=pilot_paciente_b
PILOT_PACIENTE_B_PASSWORD=CHANGE_ME_paciente_b_password

# 1 = modo padrao do laboratorio (fraquezas ativas), 0 = modo corrigido
PILOT_VULNERABLE=1
# Vida do token de acesso, em segundos
PILOT_JWT_TTL_SECONDS=300
# Tentativas de login por minuto antes do 429
PILOT_LOGIN_MAX_PER_MINUTE=5
# 1 = exige o par XSRF nas escritas (padrao), 0 = desliga so para depurar um cliente
PILOT_XSRF_ENFORCED=1

# Portas do host (sempre publicadas em 127.0.0.1)
PILOT_HOST_PORT=18080
PILOT_MGMT_HOST_PORT=19091

# Somente para o perfil "oracle"
PILOT_ORACLE_PASSWORD=CHANGE_ME_oracle_password
